+/*
+ * The reference enables SCRM AUXCLK1 (fref_clk2_out, SYS_CLK/3 = 12.8 MHz)
+ * before it probes the WL1283.  A late_initcall ran after the MMC5 probe
+ * (device_initcall), so the first session-32 test was too late; do it here,
+ * before mmc_add_host() starts the rescan.
+ */
+static void __maybe_unused pb_enable_fref_clk2(void)
+{
+	struct of_phandle_args clkspec = { };
+	struct device_node *np;
+	struct clk *clk;
+	int ret;
+
+	np = of_find_node_by_name(NULL, "auxclk1_ck");
+	if (!np) {
+		pr_info("PLAYBOOK: fref: no auxclk1_ck node\n");
+		return;
+	}
+	clkspec.np = np;
+	clk = of_clk_get_from_provider(&clkspec);
+	of_node_put(np);
+	if (IS_ERR(clk)) {
+		pr_info("PLAYBOOK: fref: get failed %ld\n", PTR_ERR(clk));
+		return;
+	}
+	clk_set_rate(clk, 12800000);
+	ret = clk_prepare_enable(clk);
+	pr_info("PLAYBOOK: fref_clk2_out %lu Hz enable=%d\n",
+		clk_get_rate(clk), ret);
+}
+
+/*
+ * hPlatform_hardResetTnetw drives WL_EN low for 500 ms and then high before
+ * the SDIO enumeration.  The gpio-hog leaves the line high from early boot,
+ * so repeat the reference's reset before mmc_add_host() starts the rescan.
+ */
+static void __maybe_unused pb_wl1283_reset_pulse(void)
+{
+	void __iomem *g;
+	u32 v;
+
+	g = ioremap(0x48055000, 0x1000);
+	if (!g)
+		return;
+	v = readl(g + 0x134);
+	writel(v & ~(1u << 22), g + 0x134);
+	writel(1u << 22, g + 0x190);
+	mdelay(500);
+	writel(1u << 22, g + 0x194);
+	mdelay(50);
+	iounmap(g);
+	pr_info("PLAYBOOK: WL_EN reset pulse (500 ms low, 50 ms settle)\n");
+}
