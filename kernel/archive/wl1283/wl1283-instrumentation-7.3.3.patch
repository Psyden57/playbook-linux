 /*
- * MMC5 (0x480D5000) is the TI WL1283 combo's SDIO bus.  The WL1283
- * bring-up (sdmmc5 pads, the FREF clock, the vmmc window and the board
- * control lines) is archived under kernel/archive/wl1283/ and is to be
- * re-derived from OS 2.1.0.1917.  Leave the controller disabled so it does
- * not probe with no board wiring.
+ * MMC5 (0x480D5000) is the TI WL1283 combo's SDIO bus — measured, not inferred
+ * (session 29, trap 97).  io-pkt's process map (`pidin mem`) shows
+ * devnp-ti1283.so holding `/dev/mem 0x480d5000` (8 KiB, the hsmmc block) and
+ * the mmc5 interrupt attached as QNX vector 0x5b = GIC SPI 59, which is
+ * exactly `mmc5` in omap4-l4.dtsi.  The sdmmc5 pads 0x148-0x152 read 0x0118
+ * (mux 0, pull-up, input enable) on the running TabletOS while every sdmmc1
+ * and sdmmc3 pad is still 0x000f (safe mode), and QNX never instantiates the
+ * MMC1 controller at all.  Report 176's "mmc1" was the wrong controller.
+ *
+ * The I/O rail: the TWL's VMMC is switched OFF in RIM's own rail policy
+ * (`/etc/system/config/pmic-twl6030.cfg`, "set_state vmmc off app con mod") —
+ * that is the SD-slot rail and there is no SD slot.  The 1.8 V window below is
+ * the one every mainline wl12xx board describes (e.g. omap4-epson-embt2ws);
+ * the supply exists to give the MMC core an `ocr_avail` (as with vemmc), not to
+ * switch anything.
+ *
+ * Step one is enumeration only: no wlcore child node yet, so the card comes up
+ * as a bare SDIO device and the bus/power/pinctrl are the only variables.
  */
+&omap4_pmx_core {
+	sdmmc5_pins: sdmmc5-pins {
+		pinctrl-single,pins = <
+			OMAP4_IOPAD(0x148, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc5_clk */
+			OMAP4_IOPAD(0x14a, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc5_cmd */
+			OMAP4_IOPAD(0x14c, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc5_dat0 */
+			OMAP4_IOPAD(0x14e, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc5_dat1 */
+			OMAP4_IOPAD(0x150, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc5_dat2 */
+			OMAP4_IOPAD(0x152, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc5_dat3 */
+		>;
+	};
+
+	fref_clk2_out_pins: fref-clk2-out-pins {
+		pinctrl-single,pins = <
+			OMAP4_IOPAD(0x19c, 0x0000)	/* fref_clk2_out */
+		>;
+	};
+};
+
 &mmc5 {
-	status = "disabled";
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc5_pins &fref_clk_pins &fref_clk2_out_pins>;
+	vmmc-supply = <&vwl1283>;
+	bus-width = <4>;
+	ti,non-removable;
+	non-removable;
 };
 
