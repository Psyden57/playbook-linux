 /*
+ * The WL1283's reference clock comes OUT of the SoC and is requested by the
+ * chip with CLK_REQ.  The vendor's own config says so:
+ * local/work/qnx-fw/tiwlan_winchester.ini, `STRFRefClock = 2` (38.4 MHz) with
+ * "Bit 3 - CLK_REQ type, 0 = wired-OR", and `STRFRefClockSettingTime = 5` —
+ * "the time from asserting CLK_REQ (low to high) to valid FREF clock on the
+ * device inputs".  A WiLink with no running reference clock has no running
+ * digital core: it cannot answer SDIO, cannot answer HCI on UART2 and its IRQ
+ * line never goes high, which is exactly what this unit does.
+ *
+ * These pads live in the WKUP padconf at 0x4A31E000 — a block this project had
+ * never compared with the reference.  The reference muxes the request half of
+ * each pair:
+ *
+ *   0x4A31E050  FREF_CLK0_OUT / FREF_CLK3_REQ   ours 0x01080000  ref 0x00080000
+ *   0x4A31E054  FREF_CLK0_OUT / FREF_CLK3_REQ   ours 0x010F0002  ref 0x000F0003
+ *   0x4A31E058  FREF_CLK3_OUT / FREF_CLK4_REQ   ours 0x0108010F  ref 0x000B0003
+ *   0x4A31E05C  FREF_CLK4_OUT / SYS_32K         ours 0x01000108  ref 0x0100000B
+ *
+ * The values are the reference's own readback, as with the display pads.
+ */
+&omap4_pmx_wkup {
+	/*
+	 * Offsets are relative to the pinmux node's own reg base (0x40), so the
+	 * reference's 0x4A31E050..0x05C are 0x10..0x1C here.
+	 */
+	/*
+	 * Pin 10 (0x4A31E050) is already claimed by the TWL6030 ("0-0048"),
+	 * which wants FREF_CLK0_OUT as its own 32 kHz/oscillator clock — so it
+	 * is not in this group.  The three the reference muxes differently and
+	 * nothing else owns are below.
+	 */
+	fref_clk_pins: fref-clk-pins {
+		pinctrl-single,pins = <
+			0x018 0x000B0003	/* FREF_CLK4_OUT / FREF_CLK4_REQ */
+		>;
+	};
+};
