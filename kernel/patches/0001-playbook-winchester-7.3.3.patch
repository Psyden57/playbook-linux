+static struct dsi_data *pb_late_dsi;
+
+/*
+ * Boot-time DSI/bridge read probes.  They are diagnostic only: every generic
+ * read is a BTA turnaround, and the OMAP CIO reports ERRCONTENTIONLP1_2
+ * (bit 23) on each one, so the DSI error handler logs one line per read
+ * (report 140/141).  They proved what was needed; keep them off by default so
+ * a normal boot has no spurious DSI errors.  The essential PlayBook sequence
+ * (reset, VC setup, HS clock start, bridge programming) is NOT gated.
+ */
+static bool pb_probe;
+module_param(pb_probe, bool, 0644);
+MODULE_PARM_DESC(pb_probe, "PlayBook: run the boot-time DSI/bridge read probes (default off)");
+
+
+static void pb_late_check(struct work_struct *work)
+{
+	static const u16 regs[] = {
+		0x0214,	/* DSI_LANESTATUS0: lane is in HS RX mode */
+		0x0218,	/* DSI_LANESTATUS1: lane is in ULPS or STOP */
+		0x0220,	/* DSI_INTSTATUS */
+		0x0300,	/* DSIERRCNT */
+		0x0500,	/* SYSSTAT */
+		0x049c,	/* LV_CFG */
+		0x0230,	/* DSI_LPTXTO */
+		0x0110,	/* PPI_LINEINITCNT (one of the intermittently failing reads) */
+	};
+	struct dsi_data *dsi = pb_late_dsi;
+	char line[256];
+	int i, n = 0;
+
+	if (!dsi)
+		return;
+
+	dsi_bus_lock(dsi);
+
+	if (dsi->iface_enabled) {
+		u32 hit = 0, last = 0, first = 0;
+		int k;
+
+		/*
+		 * How fast is the DISPC scanning?  LINE_STATUS advances once
+		 * per line, so two reads 1 ms apart give the line rate directly.
+		 * At the reference's 50.4 MHz pixel clock and a 1348-pixel total
+		 * the line rate is ~37.4 kHz, i.e. ~37 lines/ms; a DISPC clocked
+		 * at the 48 MHz FCK instead of the LCD PLL would give about
+		 * half that, which would break the DSI packet rate.
+		 */
+		{
+			void __iomem *dispc = ioremap(0x58001000, 0x1000);
+			u32 l1 = 0, l2 = 0, l3 = 0;
+
+			if (dispc) {
+				l1 = readl(dispc + 0x5C);	/* LINE_STATUS */
+				udelay(1000);
+				l2 = readl(dispc + 0x5C);
+				udelay(1000);
+				l3 = readl(dispc + 0x5C);
+				iounmap(dispc);
+			}
+			pr_err("pb late scan: line %u -> %u -> %u (lines/ms)\n",
+			       l1, l2, l3);
+		}
+
+		/* LANESTATUS0 is a single-sample read of a per-lane state that
+		 * changes with the HS bursts, so one zeroed read proves
+		 * nothing.  Sample it repeatedly: any non-zero value means a
+		 * lane was in HS RX mode, i.e. the video stream does arrive.
+		 */
+		for (k = 0; k < 24; k++) {
+			u32 ls = 0;
+			int rr = pb_bridge_read(dsi, 0x0214, &ls);
+
+			if (k == 0)
+				first = rr ? 0xffffffff : ls;
+			if (!rr && ls) {
+				if (!hit)
+					last = ls;
+				hit++;
+			}
+		}
+		pr_err("pb late lanes: first=0x%08x nonzero=%d last=0x%08x\n",
+		       first, hit, last);
+
+		/*
+		 * Repeat every read: the point of this dump is no longer just
+		 * the values but whether they can be obtained at all.  With the
+		 * reference's PPI_TX_RX_TA (4) these reads failed intermittently
+		 * with -EIO from the bus turnaround; booting with
+		 * 0x00040006 and seeing ok=8/8 here is the measurement that
+		 * makes LANESTATUS0 = 0 trustworthy (report 131 §4g).
+		 */
+		for (i = 0; i < ARRAY_SIZE(regs); i++) {
+			u32 lv = 0;
+			int ok = 0, k;
+
+			for (k = 0; k < 8; k++) {
+				u32 x = 0;
+
+				pb_vc_setup_lp(dsi);
+				if (!pb_bridge_read(dsi, regs[i], &x)) {
+					ok++;
+					lv = x;
+				}
+			}
+			n += scnprintf(line + n, sizeof(line) - n,
+				       " %04x=%08x%c%d/8", regs[i], lv,
+				       ok == 8 ? ' ' : '!', ok);
+		}
+		pr_err("pb late bridge:%s\n", line);
+	} else {
+		pr_err("pb late bridge: interface not enabled, skipped\n");
+	}
+
+	dsi_bus_unlock(dsi);
+}
+
+static DECLARE_DELAYED_WORK(pb_late_work, pb_late_check);
+
+static void pb_bridge_program(struct dsi_data *dsi)
+{
+	/*
+	 * Session 14 experiment: do NOT pulse RESX here.
+	 *
+	 * The bridge's register state survives a warm reset (trap 28; that is
+	 * why QNX's grey self-test pattern was still on the panel after
+	 * booting Linux over it).  So at this point the bridge is in
+	 * whatever state the previous OS left it in — a programmed,
+	 * DSI-RX-running state that QNX has already proven it accepts
+	 * generic writes in.  Our previous image pulsed RESX first, which
+	 * destroys that state, and then failed to reprogram it — so the
+	 * pulse made the experiment unfalsifiable.
+	 *
+	 * With it removed:
+	 *   - if the IDREG read and the GPIO36 test now succeed, the bridge
+	 *     was fine and our RESX pulse/sequence was the problem;
+	 *   - if they still fail, the fault is in this host's DSI packet
+	 *     path, not in the bridge's state.
+	 *
+	 * pb_bridge_gpio_test() leaves 0x0524 = 0, so this image is still a
+	 * diagnostic and must not be treated as a display build.
+	 */
+	/*
+	 * The reference pulses RESX here, before it programs the bridge
+	 * (winch_lcdctl 0x192d4/0x19338: CLEARDATAOUT, 20 ms, SETDATAOUT,
+	 * 20 ms).  We removed this while chasing the delivery failure, on the
+	 * theory that the boot chain left the bridge configured.  It does not
+	 * — IDREG reads -5 before the sequence on every boot — so the chip has
+	 * never had a proper reset edge before being programmed.
+	 */
+	tc358764_playbook_reset(dsi->dsidev);
+
+	pb_vc_setup_lp(dsi);
+
+	/* this is what starts the HS clock; without it nothing reaches the bridge */
+	pb_start_hs_clock(dsi);
+
+	usleep_range(1000, 2000);
+
+	pb_vc_setup_lp(dsi);
+
+	if (pb_probe)
+		pb_bridge_probe(dsi, "before-seq");
+
+	/* a failed BTA clears VC_EN behind our back; restore before writing */
+	pb_vc_setup_lp(dsi);
+
+	pb_bridge_send_seq(dsi);
+
+	if (pb_probe) {
+		pb_bridge_probe(dsi, "after-seq");
+
+		pb_vc_setup_lp(dsi);
+		pb_bridge_dump(dsi);
+	}
+}
+
+/*
+ * PlayBook debug hook.  Now that the TC358764 answers, iterating on it costs a
+ * flash + boot per hypothesis unless it can be reached from the console:
+ *
+ * The console's `write` command passes only the first token, so the format has
+ * no spaces:  "r<addr>" to read, "w<addr>:<val>" to write, "t<addr>" to read
+ * the same register 16 times and report how many attempts answered, "v" to
+ * test whether the video VC is still being fed.
+ */
+static ssize_t pb_reg_store(struct device *dev, struct device_attribute *attr,
+			    const char *buf, size_t count)
+{
+	struct dsi_data *dsi = dev_get_drvdata(dev);
+	unsigned int addr = 0, val = 0;
+	char op;
+	int n, r = 0;
+
+	n = sscanf(buf, "%c%x:%x", &op, &addr, &val);
+	if (n < 1)
+		return -EINVAL;
+	/* 'v' takes no argument; every other op needs at least an address */
+	if (op != 'v' && n < 2)
+		return -EINVAL;
+
+	dsi_bus_lock(dsi);
+
+	if (!dsi->iface_enabled) {
+		r = -ENODEV;
+	} else if (op == 'w' && n == 3) {
+		pb_vc_setup_lp(dsi);
+		pb_bridge_write(dsi, addr, val);
+		pr_err("pb reg: w %04x <- %08x\n", addr, val);
+	} else if (op == 'v') {
+		/*
+		 * Is the host really sending video?  PACKET_SENT is sticky, so
+		 * clear it and see whether it comes back: in video mode a long
+		 * packet is sent every line (~37 kHz), so it reappears within a
+		 * few microseconds if the engine is running.
+		 */
+		u32 a, b;
+
+		dsi_write_reg(dsi, DSI_VC_IRQSTATUS(VC_VIDEO), 0xffffffff);
+		usleep_range(5000, 6000);
+		a = dsi_read_reg(dsi, DSI_VC_IRQSTATUS(VC_VIDEO));
+		usleep_range(5000, 6000);
+		b = dsi_read_reg(dsi, DSI_VC_IRQSTATUS(VC_VIDEO));
+		pr_err("pb reg: video irq 0x%08x then 0x%08x -> PACKET_SENT %d %d (VC0=0x%08x)\n",
+		       a, b, !!(a & DSI_VC_IRQ_PACKET_SENT),
+		       !!(b & DSI_VC_IRQ_PACKET_SENT),
+		       dsi_read_reg(dsi, DSI_VC_CTRL(VC_VIDEO)));
+	} else if (op == 't') {
+		/*
+		 * Read one register 16 times and report how many attempts
+		 * answered.  This is the A/B instrument for PPI_TX_RX_TA
+		 * (report 131 §4g): "w013c:4", "t0214", "w013c:40006",
+		 * "t0214" — same boot, one variable.  The VC is re-armed
+		 * before each attempt because a failed BTA clears VC_EN.
+		 */
+		u32 last = 0;
+		int ok = 0, i;
+
+		for (i = 0; i < 16; i++) {
+			u32 x = 0;
+
+			pb_vc_setup_lp(dsi);
+			if (!pb_bridge_read(dsi, addr, &x)) {
+				ok++;
+				last = x;
+			}
+		}
+		pr_err("pb reg: t %04x ok=%d/16 fail=%d value=%08x\n",
+		       addr, ok, 16 - ok, last);
+	} else if (op == 'u') {
+		/*
+		 * As 't', but without re-arming the VC between attempts.  This
+		 * is the control that separates "the register value matters"
+		 * from trap 37 ("a failed BTA clears VC_EN"): run "t0214" and
+		 * "u0214" in the same boot and compare.
+		 */
+		u32 last = 0;
+		int ok = 0, i;
+
+		for (i = 0; i < 16; i++) {
+			u32 x = 0;
+
+			if (!pb_bridge_read(dsi, addr, &x)) {
+				ok++;
+				last = x;
+			}
+		}
+		pr_err("pb reg: u %04x ok=%d/16 fail=%d value=%08x (no VC re-arm)\n",
+		       addr, ok, 16 - ok, last);
+	} else if (op == 'd') {
+		/*
+		 * Dump every 32-bit register in [addr, val] to kmsg, 8 per
+		 * line.  This is what makes a whole-map diff against a capture
+		 * from a working TabletOS display possible in one command
+		 * (tools/qnx-dsiread.c does the capturing side).
+		 */
+		char line[160];
+		int used = 0, k = 0;
+		unsigned r;
+
+		line[0] = 0;
+		for (r = addr; r <= val; r += 4) {
+			u32 v = 0;
+			int e;
+
+			pb_vc_setup_lp(dsi);
+			e = pb_bridge_read(dsi, r, &v);
+			used += scnprintf(line + used, sizeof(line) - used,
+					  "%04x=%08x%c", r, v, e ? '!' : ' ');
+			if (++k == 8 || r + 4 > val) {
+				pr_err("pb dump: %s\n", line);
+				line[0] = 0;
+				used = 0;
+				k = 0;
+			}
+		}
+	} else if (op == 'r') {
+		u32 v = 0;
+
+		pb_vc_setup_lp(dsi);
+		r = pb_bridge_read(dsi, addr, &v);
+		pr_err("pb reg: r %04x -> %d %08x\n", addr, r, v);
+	} else {
+		r = -EINVAL;
+	}
+
+	dsi_bus_unlock(dsi);
+
+	return r ? r : count;
+}
