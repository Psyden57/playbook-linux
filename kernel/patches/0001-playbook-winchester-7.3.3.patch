+static void pb_bridge_dump(struct dsi_data *dsi)
+{
+	static const u16 regs[] = {
+		0x0500,	/* SYSSTAT */
+		0x0504,	/* SYS_RST        (we write 4) */
+		0x049c,	/* LV_CFG         (we write 1) */
+		0x04a0,	/* LV_PHY0        (we write 0x0004c02d) */
+		0x0450,	/* VP_CTRL        (0x03f00120) */
+		0x0454,	/* VP_HTIM1       (0x78000001) */
+		0x0458,	/* VP_HTIM2       (0x76000400) */
+		0x045c,	/* VP_VTIM1       (0x000a0001) */
+		0x0460,	/* VP_VTIM2       (0x000c0258) */
+		0x0464,	/* VP_VFUEN       (1) */
+		0x0520,	/* GPIOC          (5) */
+		0x0524,	/* GPIOO          (5) */
+		0x0210,	/* DSI_LANEENABLE (0x1f) */
+		0x0104,	/* PPI_STARTPPI   (1) */
+		0x0204,	/* DSI_STARTDSI   (1) */
+		0x0580,	/* IDREG          (0x00006500) */
+	};
+	char line[320];
+	int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		u32 v = 0;
+		int r = pb_bridge_read(dsi, regs[i], &v);
+
+		n += scnprintf(line + n, sizeof(line) - n, " %04x=%08x%s",
+			       regs[i], v, r ? "!" : "");
+	}
+
+	pr_err("pb bridge dump:%s\n", line);
+
+	/*
+	 * The D-PHY / PPI-lite block.  Neither the reference's sequence nor any
+	 * working driver writes these (mainline's gma500 tc35876x driver and the
+	 * msm one both leave them alone), so what is here is the chip's POR
+	 * state — worth recording because it is what the HS receiver runs on.
+	 */
+	{
+		static const u16 dphy[] = {
+			0x0004,	/* D0W_DPHYCONTTX */
+			0x0020,	/* CLW_DPHYCONTRX */
+			0x0024,	/* D0W_DPHYCONTRX */
+			0x0028,	/* D1W_DPHYCONTRX */
+			0x0038,	/* COM_DPHYCONTRX */
+			0x0040,	/* CLW_CNTRL */
+			0x0044,	/* D0W_CNTRL */
+			0x0110,	/* PPI_LINEINITCNT */
+			0x0118,
+			0x01f0,	/* HSTIMEOUT */
+			0x01f4,	/* HSTIMEOUTENABLE */
+		};
+
+		n = 0;
+		for (i = 0; i < ARRAY_SIZE(dphy); i++) {
+			u32 v = 0;
+			int r = pb_bridge_read(dsi, dphy[i], &v);
+
+			n += scnprintf(line + n, sizeof(line) - n, " %04x=%08x%s",
+				       dphy[i], v, r ? "!" : "");
+		}
+		pr_err("pb dphy dump:%s\n", line);
+	}
+}
