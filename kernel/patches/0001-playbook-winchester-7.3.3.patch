+/*
+ * PlayBook (winchester): program the TC358764 at the reference's point —
+ * after the DSI PHY/PLL/protocol-engine setup and BEFORE the VC/interface is
+ * enabled for video.  winch_lcdctl calls its bridge programmer (0x13e50) from
+ * 0x1938c, before its DSI VC enable (0x16bd8).  Doing it later through the
+ * generic-write path auto-enables the DSI (omap_dsi_host_transfer ->
+ * dsi_enable), so the VC setup and null packet run first; the bridge then
+ * never receives the register writes (report 126 delivery test: GPIO36 never
+ * followed 0x0524 bit 0).
+ */
+struct pb_bridge_reg {
+	u16 addr;
+	u32 val;
+	u8 delay_ms;
+};
+
+/* implemented in drivers/gpu/drm/bridge/tc358764.c, built-in for this board */
+extern void tc358764_playbook_reset(struct mipi_dsi_device *dsi);
+
+static const struct pb_bridge_reg pb_bridge_seq[] = {
+	/*
+	 * PPI_TX_RX_TA is the DSI bus turn-around timing, i.e. the window the
+	 * bridge gets to drive the lane back.  Session 15 measured it, twice:
+	 *
+	 *   boot with 4        -> boot-time reads 4/8, "t" samples 8/16
+	 *   boot with 0x40006  -> boot-time reads 8/8, "t" samples 16/16
+	 *
+	 * and changing 0x013c after boot in either direction does not move
+	 * the rate.  The value is latched by PPI_STARTPPI (0x0104), which this
+	 * sequence writes 8 entries below.  That also explains session 14's
+	 * intermittent -EIO.
+	 *
+	 * It is also the only value in the whole bridge/DSI configuration where
+	 * we deliberately differ from the reference.  A build with the
+	 * reference's 4 was flashed to test whether that deviation destabilises
+	 * the video link: it does not make the picture worse, so the reliable
+	 * reads win and 0x40006 stays.  Report 133.
+	 */
+	{ 0x013c, 0x00040006, 0 },	/* PPI_TX_RX_TA */
+	{ 0x0114, 0x00000004, 0 },	/* PPI_LPTXTIMECNT */
+	{ 0x0164, 0x00000004, 0 },	/* PPI_D0S_CLRSIPOCOUNT */
+	{ 0x0168, 0x00000004, 0 },	/* PPI_D1S_CLRSIPOCOUNT */
+	{ 0x016c, 0x00000004, 0 },	/* PPI_D2S_CLRSIPOCOUNT */
+	{ 0x0170, 0x00000004, 0 },	/* PPI_D3S_CLRSIPOCOUNT */
+	{ 0x0210, 0x0000001f, 0 },	/* DSI_LANEENABLE */
+	{ 0x0134, 0x0000001f, 0 },	/* PPI_LANEENABLE */
+	{ 0x0104, 0x00000001, 0 },	/* PPI_STARTPPI */
+	{ 0x0204, 0x00000001, 0 },	/* DSI_STARTDSI */
+	{ 0x04a4, 0x00000000, 0 },
+	{ 0x04a0, 0x0044c02d, 0 },	/* LV_PHY0, reset asserted */
+	{ 0x0480, 0x03020100, 0 },	/* LV_MX0003 */
+	{ 0x0484, 0x08050704, 0 },	/* LV_MX0407 */
+	{ 0x0488, 0x0f0e0a09, 0 },	/* LV_MX0811 */
+	{ 0x048c, 0x100d0c0b, 0 },	/* LV_MX1215 */
+	{ 0x0490, 0x12111716, 0 },	/* LV_MX1619 */
+	{ 0x0494, 0x1b151413, 0 },	/* LV_MX2023 */
+	{ 0x0498, 0x061a1819, 0 },	/* LV_MX2427 */
+	{ 0x0450, 0x03f00120, 0 },	/* VP_CTRL */
+	/*
+	 * VP_HTIM1 = HBP[24:16] | HPW[8:0], VP_HTIM2 = HFP[24:16] | HACT[10:0].
+	 * Session 15: these were 0x78000001 / 0x76000400, which puts the
+	 * porches in the reserved top byte; they read back as 0x00000001 /
+	 * 0x00000400 (HBP = HFP = 0) and report 131 mis-read that as "the
+	 * upper half is not stored".  The reference's own values are
+	 * 0x00780001 / 0x00760400 (winch_lcdctl 0x13f78/0x13f88, report 130),
+	 * i.e. HBP 120, HPW 1, HFP 118, HACT 1024 — and a whole-map diff
+	 * against TabletOS showed these as the only configuration registers
+	 * that differed.  Report 132.
+	 */
+	{ 0x0454, 0x00780001, 0 },	/* VP_HTIM1 */
+	{ 0x0458, 0x00760400, 0 },	/* VP_HTIM2 */
+	{ 0x045c, 0x000a0001, 0 },	/* VP_VTIM1 */
+	{ 0x0460, 0x000c0258, 100 },	/* VP_VTIM2, then 100 ms */
+	{ 0x04a0, 0x0004c02d, 0 },	/* LV_PHY0, reset released */
+	{ 0x049c, 0x00000001, 0 },	/* LV_CFG = LVEN */
+	{ 0x0520, 0x00000005, 0 },
+	{ 0x0524, 0x00000005, 0 },
+	{ 0x0504, 0x00000004, 0 },	/* SYS_RST_LCD */
+	{ 0x0464, 0x00000001, 0 },	/* VP_VFUEN */
+};
+
+static void pb_bridge_write(struct dsi_data *dsi, u16 addr, u32 val)
+{
+	u8 data[6] = {
+		addr & 0xff, addr >> 8,
+		val & 0xff, (val >> 8) & 0xff, (val >> 16) & 0xff, (val >> 24) & 0xff,
+	};
+	int t;
+
+	/* wait until the previous packet has left the VC TX FIFO */
+	for (t = 0; t < 1000; t++) {
+		u32 s = dsi_read_reg(dsi, DSI_VC_CTRL(VC_CMD));
+
+		if (!(s & BIT(16)) && !(s & BIT(5)))
+			break;
+		udelay(10);
+	}
+	dsi_vc_write_long_header(dsi, VC_CMD, 0, MIPI_DSI_GENERIC_LONG_WRITE, 6, 0);
+	dsi_vc_write_long_payload(dsi, VC_CMD, data[0], data[1], data[2], data[3]);
+	dsi_vc_write_long_payload(dsi, VC_CMD, data[4], data[5], 0, 0);
+	/* and wait for this one to drain before the caller writes again */
+	for (t = 0; t < 1000; t++) {
+		if (!(dsi_read_reg(dsi, DSI_VC_CTRL(VC_CMD)) & BIT(5)))
+			break;
+		udelay(10);
+	}
+}
+
+/*
+ * PlayBook delivery probe.  Session 14: the GPIO36 read-back proved that the
+ * bridge does not react to our writes, and the OMAP DSI reports PACKET_SENT
+ * with no error — i.e. the packet leaves the host and nothing answers.  A DSI
+ * generic read is the only test that distinguishes "the bridge is alive and
+ * receiving" from "the bridge is not there": a working driver for this chip
+ * (Qualcomm msm mipi_tc358764_dsi2lvds.c) reads IDREG 0x0580 and requires
+ * 0x00006500 before programming anything.
+ *
+ * dsi_vc_generic_read() is used directly, not mipi_dsi_generic_read(): the
+ * latter goes through omap_dsi_host_transfer(), which calls dsi_enable() when
+ * the interface is down, and dsi_enable() calls dsi_init_dsi() — i.e. it would
+ * re-enter the very function we are called from.
+ */
+static int pb_bridge_read(struct dsi_data *dsi, u16 addr, u32 *val)
+{
+	u8 req[2] = { addr & 0xff, addr >> 8 };
+	const struct mipi_dsi_msg msg = {
+		.channel = 0,
+		.type = MIPI_DSI_GENERIC_READ_REQUEST_2_PARAM,
+		.tx_len = sizeof(req),
+		.tx_buf = req,
+		.rx_len = sizeof(*val),
+		.rx_buf = val,
+	};
+
+	*val = 0;
+
+	return dsi_vc_generic_read(&dsi->output, VC_CMD, &msg);
+}
+
+static void pb_bridge_probe(struct dsi_data *dsi, const char *when)
+{
+	u32 id, gpioo, sysstat;
+	int ri, rg, rs;
+
+	ri = pb_bridge_read(dsi, 0x0580, &id);		/* IDREG */
+	rg = pb_bridge_read(dsi, 0x0524, &gpioo);	/* GPIOO */
+	rs = pb_bridge_read(dsi, 0x0500, &sysstat);	/* SYSSTAT */
+
+	pr_err("pb probe %s: VC1=0x%08x IDREG r=%d 0x%08x (want 0x00006500) "
+	       "GPIOO r=%d 0x%08x SYSSTAT r=%d 0x%08x\n",
+	       when, dsi_read_reg(dsi, DSI_VC_CTRL(VC_CMD)),
+	       ri, id, rg, gpioo, rs, sysstat);
+}
+
+static void pb_bridge_send_seq(struct dsi_data *dsi)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(pb_bridge_seq); i++) {
+		pb_bridge_write(dsi, pb_bridge_seq[i].addr, pb_bridge_seq[i].val);
+		if (pb_bridge_seq[i].delay_ms)
+			msleep(pb_bridge_seq[i].delay_ms);
+	}
+}
+
+/*
+ * QNX's bridge-GPIO self-test (winch_lcdctl 0x196dc, report 126): 0x0524 bit 0
+ * drives the pin on the GPIO36 net (OMAP GPIO2_4), bit 2 the one on GPIO171.
+ * Returns true only if GPIO36 followed bit 0 for every pattern.
+ */
+static bool __maybe_unused pb_bridge_gpio_test(struct dsi_data *dsi)
+{
+	static const u32 vals[] = { 1, 4, 5, 0 };
+	void __iomem *gpio2;
+	u32 v;
+	bool ok = true;
+	int i;
+
+	gpio2 = ioremap(0x48055000, 0x1000);
+	if (!gpio2) {
+		pr_err("pb gpio test: cannot map GPIO2\n");
+		return false;
+	}
+
+	pb_bridge_write(dsi, 0x0520, 5);	/* GPIOC: pins 0 and 2 out */
+	usleep_range(1000, 2000);
+
+	for (i = 0; i < ARRAY_SIZE(vals); i++) {
+		u32 want = vals[i] & 1;
+
+		pb_bridge_write(dsi, 0x0524, vals[i]);	/* GPIOO */
+		usleep_range(1000, 2000);
+		v = readl(gpio2 + 0x138);		/* GPIO2_DATAIN */
+		pr_err("pb gpio test 0x0524=%u -> DATAIN=0x%08x GPIO36=%u want %u\n",
+		       vals[i], v, !!(v & BIT(4)), want);
+		if (!!(v & BIT(4)) != want)
+			ok = false;
+	}
+
+	iounmap(gpio2);
+
+	return ok;
+}
+
+static void pb_vc_setup_lp(struct dsi_data *dsi)
+{
+	/*
+	 * QNX's command-VC word: bit 12 (RGB565_ORDER) set, DMA_TX_REQ_NB 0,
+	 * MODE_SPEED (bit 9) = 0 = LP.  (Session 14 correction: the earlier
+	 * "QNX runs HS" reading was wrong — see report 129.)
+	 */
+	dsi_write_reg(dsi, DSI_VC_CTRL(VC_CMD), 0x20009d81);
+	dsi_if_enable(dsi, 1);
+	usleep_range(1000, 2000);
+}
+
+/*
+ * Start the DSI HS clock the way the reference does.
+ *
+ * L1DSS_DSI1_lp_mode_start_DSI_QNX (winch_lcdctl 0x17094, report 128 §1.1)
+ * finishes by writing VC_SHORT_PACKET_HEADER(1) = 0 — a MIPI null packet —
+ * and busy-polling VC_IRQSTATUS(1) for PACKET_SENT, then does the same on
+ * VC0.  Its error string is literally "Could not send inital null packet to
+ * start HS clock".
+ *
+ * Until that happens the clock lane is idle, so the TC358764's DSI receiver
+ * has nothing to lock to and drops every packet the protocol engine hands to
+ * the PHY — which is exactly what we measured: PACKET_SENT with no error on
+ * our side, and no reaction at all on the bridge.
+ */
+static void pb_start_hs_clock(struct dsi_data *dsi)
+{
+	u32 v = 0;
+	int i;
+
+	/*
+	 * Read-modify-write, not a whole-word store: VC0 already carries the
+	 * DMA/no-DMA and FIFO fields from dsi_vc_initial_config(), and
+	 * clobbering them with the command-VC word broke the video VC.
+	 * Here we only need command mode (bit 4 = 0), HS (bit 9) and VC_EN.
+	 */
+	{
+		u32 r = dsi_read_reg(dsi, DSI_VC_CTRL(VC_VIDEO));
+
+		r &= ~BIT(4);
+		r |= BIT(9) | BIT(0);
+		dsi_write_reg(dsi, DSI_VC_CTRL(VC_VIDEO), r);
+	}
+	dsi_if_enable(dsi, 1);
+	usleep_range(1000, 2000);
+
+	dsi_write_reg(dsi, DSI_VC_IRQSTATUS(VC_VIDEO), DSI_VC_IRQ_PACKET_SENT);
+	dsi_write_reg(dsi, DSI_VC_SHORT_PACKET_HEADER(VC_VIDEO), 0);
+
+	for (i = 0; i < 2000; i++) {
+		v = dsi_read_reg(dsi, DSI_VC_IRQSTATUS(VC_VIDEO));
+		if (v & DSI_VC_IRQ_PACKET_SENT)
+			break;
+		udelay(10);
+	}
+
+	pr_err("pb hs-clock: null packet on VC0/HS -> irqstatus=0x%08x polls=%d%s\n",
+	       v, i, (v & DSI_VC_IRQ_PACKET_SENT) ? "" : " (NO PACKET_SENT)");
+
+	/* Step 2 — the reference then does the same on VC1 (LP). */
+	dsi_write_reg(dsi, DSI_VC_IRQSTATUS(VC_CMD),
+		      DSI_VC_IRQ_PACKET_SENT);
+	dsi_write_reg(dsi, DSI_VC_SHORT_PACKET_HEADER(VC_CMD), 0);
+
+	for (i = 0; i < 2000; i++) {
+		v = dsi_read_reg(dsi, DSI_VC_IRQSTATUS(VC_CMD));
+		if (v & DSI_VC_IRQ_PACKET_SENT)
+			break;
+		udelay(10);
+	}
+
+	pr_err("pb hs-clock: null packet on VC1/LP -> irqstatus=0x%08x polls=%d%s\n",
+	       v, i, (v & DSI_VC_IRQ_PACKET_SENT) ? "" : " (NO PACKET_SENT)");
+}
