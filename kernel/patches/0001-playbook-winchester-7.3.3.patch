--- a/include/linux/pb_event.h
+++ b/include/linux/pb_event.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * PlayBook bring-up: printk-free event log in the DEBUG_LL ring page.
+ *
+ * The DRAM ring page at PA 0x88000000 is reachable through the permanent
+ * non-cacheable alias 0xFE800000 (omap44xx_io_desc).  ring_put uses +0x80
+ * (count), +0x84 (index) and +0x100..+0x7F7F (chars), so the chainloader
+ * breadcrumb words at +0x00..+0x7C are free while the kernel runs.
+ *
+ * Layout (initialised early from the GIC driver, before any IRQ):
+ *   +0x00  heartbeat: (0x3700 << 16) | (jiffies & 0xffff), one per timer IRQ
+ *   +0x08  magic 0x50424556 ("PBEV")
+ *   +0x0c  event counter (u32)
+ *   +0x10  ring of 28 u32 events, slot = counter % 28
+ *
+ * Each event word is: (code16 << 16) | (jiffies & 0xffff), so a post-mortem
+ * read gives both the sequence and the time it happened.  This is
+ * deliberately not printk: it must work in IRQ context, before console
+ * output can be emitted, and while the CPU is about to stop.
+ */
+#ifndef _LINUX_PB_EVENT_H
+#define _LINUX_PB_EVENT_H
+
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/types.h>
+
+#define PB_EVENT_VA		0xfe800000
+#define PB_EVENT_MAGIC		0x50424556	/* "PBEV" */
+#define PB_EVENT_SLOTS		28
+#define PB_EVENT_HEARTBEAT_OFF	0x00
+#define PB_EVENT_MAGIC_OFF	0x08
+#define PB_EVENT_COUNT_OFF	0x0c
+#define PB_EVENT_SLOTS_OFF	0x10
+
+/*
+ * __raw_*: no barrier, so a stuck posted peripheral write cannot stall these.
+ * A positive heartbeat is therefore proof the CPU is still executing with
+ * interrupts enabled; a negative one is inconclusive (DRAM path may be
+ * blocked or IRQs off).
+ */
+static inline void pb_event_init(void)
+{
+	void __iomem *ev = (void __iomem *)PB_EVENT_VA;
+
+	__raw_writel(0x37000000u, ev + PB_EVENT_HEARTBEAT_OFF);
+	__raw_writel(PB_EVENT_MAGIC, ev + PB_EVENT_MAGIC_OFF);
+	__raw_writel(0, ev + PB_EVENT_COUNT_OFF);
+	dsb();
+}
+
+static inline void pb_event(u16 code)
+{
+	void __iomem *ev = (void __iomem *)PB_EVENT_VA;
+	u32 n = __raw_readl(ev + PB_EVENT_COUNT_OFF);
+
+	__raw_writel(((u32)code << 16) | (jiffies & 0xffff),
+		     ev + PB_EVENT_SLOTS_OFF + (n % PB_EVENT_SLOTS) * 4);
+	__raw_writel(n + 1, ev + PB_EVENT_COUNT_OFF);
+}
+
+static inline void pb_ptr(u32 val)
+{
+	__raw_writel(val, (void __iomem *)PB_EVENT_VA + 0x04);
+}
+
+static inline void pb_tick(void)
+{
+	void __iomem *ev = (void __iomem *)PB_EVENT_VA;
+
+	__raw_writel(0x37000000u | (jiffies & 0xffff),
+		     ev + PB_EVENT_HEARTBEAT_OFF);
+}
+
+#endif /* _LINUX_PB_EVENT_H */
