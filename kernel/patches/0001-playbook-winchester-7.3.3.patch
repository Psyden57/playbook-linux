+/* PlayBook bring-up: record how many async entries are pending and the
+ * function pointer of the oldest one (the one blocking the sync). */
+static void pb_async_dump(void)
+{
+	struct async_entry *first;
+	unsigned long flags;
+
+	pb_event(0x7200 | (atomic_read(&entry_count) & 0xff));
+
+	spin_lock_irqsave(&async_lock, flags);
+	if (!list_empty(&async_global_pending)) {
+		first = list_first_entry(&async_global_pending,
+					 struct async_entry, global_list);
+		__raw_writel((u32)(unsigned long)first->func,
+			     (void __iomem *)PB_EVENT_VA + 0x04);
+	}
+	spin_unlock_irqrestore(&async_lock, flags);
+}
+
 void async_synchronize_full(void)
 {
+	pb_event(0x7101);
+	pb_async_dump();
 	async_synchronize_full_domain(NULL);
+	pb_event(0x7102);
 }
