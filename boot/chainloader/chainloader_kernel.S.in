@ chainloader_kernel.S.in — CRC-path chainloader: copy zImage+DTB high, jump
@ Placeholders __...__ are substituted by build_kernel_image.py.
@ Entry: 0x80100000, ARM, SVC, MMU off, IRQ/FIQ masked, WDT2 armed.

        .syntax unified
        .arm
        .text
        .global _start

        .equ GPIO1,       0x4A310000
        .equ GPIO_CLEAR,  0x190
        .equ GPIO_SET,    0x194
        .equ EN_BIT,      0x2000
        .equ UART3,       0x48020000
        .equ BC_PRIMARY,  0x90000000
        .equ BC_MIR1,     0x94000000
        .equ BC_MIR2,     0x88000000
        .equ BC_MIR3,     0x9FE00000

        @ Epoch test (report 108 §6.3): delay kernel entry by a fixed wall
        @ clock time, measured on the always-on WDT2 counter (32.768 kHz,
        @ CRR counts UP from LDR towards 0xffffffff, overflow = reset).
        @ WDT2 is the one timer we *know* is running here: it is what
        @ resets the SoC ~58.6 s after the kernel halts.  0 disables.
        .equ WDT2_CRR,    0x4A314028
        .equ WDT2_BASE,   0x4A314000
        .equ SYNC32K,     0x4A304010
        .equ EP_TICKS,    __EP_TICKS__
        .equ BL_PROBE,    __BL_PROBE__

        @ WDT2 stays the *kernel's* to program (report 109 §8.1, trap 115).
        @ Session 62 tried to extend the window here with the same WSPR
        @ sequence and it wedged the unit before the kernel ran, leaving the
        @ timer stopped so it never reset: do NOT touch WDT2 from the
        @ chainloader.  The loader's 7.8125 s window stands.

        .equ ZIMAGE_SRC,  __ZIMAGE_SRC__
        .equ ZIMAGE_SIZE, __ZIMAGE_SIZE__
        .equ DTB_SRC,     __DTB_SRC__
        .equ DTB_SIZE,    __DTB_SIZE__
        .equ KERNEL_DEST, __KERNEL_DEST__
        .equ DTB_DEST,    __DTB_DEST__

        @ Ring hand-off.  The DEBUG_LL ring is ONE append-only character
        @ stream per page: count +0x80, index +0x84, chars +0x100..+0x7FFF.
        @ It used to be cleared here — header plus the first 0xF80 bytes —
        @ which destroyed the whole log of a kernel that died early: such a
        @ log is shorter than the 3840 characters that reach +0x1000, so the
        @ read-back boot's chainloader erased all of it.  The "printk window
        @ at +0x1000" was never a second writer: it is this stream at
        @ character #3840, the first byte past the old clear, and it held
        @ stale text whenever the boot under test wrote fewer characters.
        @ (Session 62, report 255, trap 317a.)
        @
        @ So: do not clear.  A boot keeps writing where the previous one
        @ stopped, so the failed log survives the read-back boot (which
        @ appends ~1.6 KB after it, never over it).  Record the last two
        @ entry headers here, so the two most recent boots can be delimited
        @ exactly:
        @   +0xb8  magic "RHND" (0x444E4852), written last
        @   +0xbc  prev_count      entry count of THIS boot = end of prev log
        @   +0xc0  prev_index
        @   +0xc4  prevprev_count  entry count of the boot before     = start of
        @   +0xc8  prevprev_index                                      prev log
        @   +0xcc  prev_tjump     previous boot's WDT2 CRR at kernel jump
        @   +0xd0  prev_tentry    previous boot's WDT2 CRR at kernel entry
        @   +0xd4  prev_magic     previous boot's kernel-entry stamp (0x51000001)
        @ prev log = chars from prevprev_index, prev_count-prevprev_count long
        @ this log = chars from prev_index,     count-prev_count long
        @ The three timing words are what make a failed boot's timing readable
        @ later: the kernel's head.S samples WDT2 CRR into +0x18 at entry, and
        @ this boot's own epoch block overwrites +0x88..+0xb3 (so +0x90, the
        @ chainloader's pre-jump CRR, would otherwise be lost).  Both are read
        @ only — WDT2 is never written from here (trap 322).
        @ A header that cannot be a live one (a QNX boot leaves 0xAA fill, and
        @ index 0xAAAAAAAA would walk the character store out of the page) is
        @ reset to zero instead.
        .macro ring_handoff, base
        ldr     r0, =\base
        ldr     r1, [r0, #0x80]          @ count
        ldr     r2, [r0, #0x84]          @ index
        cmp     r2, #0x7F00
        blo     97f
        mov     r1, #0
        mov     r2, #0
        str     r1, [r0, #0x80]
        str     r2, [r0, #0x84]
97:
        ldr     r3, [r0, #0xbc]          @ prev -> prevprev
        ldr     r12, [r0, #0xc0]
        str     r3, [r0, #0xc4]
        str     r12, [r0, #0xc8]
        str     r1, [r0, #0xbc]          @ this entry -> prev
        str     r2, [r0, #0xc0]
        ldr     r3, [r0, #0x90]          @ previous boot's pre-jump CRR
        str     r3, [r0, #0xcc]
        ldr     r3, [r0, #0x18]          @ previous boot's kernel-entry CRR
        str     r3, [r0, #0xd0]
        ldr     r3, [r0, #0x14]          @ previous boot's entry stamp
        str     r3, [r0, #0xd4]
        ldr     r3, =0x444E4852          @ "RHND"
        str     r3, [r0, #0xb8]
        dsb
        .endm

_start:
        ldr     sp, =0x800F0000

        @ Ring hand-off first, before anything else can write a character:
        @ keep the previous boot's log and record this boot's entry header.
        ring_handoff BC_PRIMARY

        @ Sample the always-on WDT2 counter as early as it is safe to, so the
        @ epoch block can separate "bootrom hand-over variance" from "this
        @ chainloader's own duration".  Kept in r11 until it can be stored.
        ldr     r5, =WDT2_CRR
        ldr     r11, [r5]

        mrc     p15, 0, r0, c1, c0, 0
        bic     r0, r0, #(1 << 2)
        bic     r0, r0, #(1 << 12)
        mcr     p15, 0, r0, c1, c0, 0

        ldr     r0, =kernel_park
        mcr     p15, 0, r0, c12, c0, 0

        ldr     r4, =BC_PRIMARY
        ldr     r0, =0x4C424B43          @ "KBLB"
        str     r0, [r4, #0]
        mov     r0, #1
        str     r0, [r4, #4]
        ldr     r0, =0x4B45524E          @ "KERN"
        str     r0, [r4, #8]
        bl      bc_mirrors
        @ (no ring clear: ring_handoff above keeps the stream append-only)
        str     r11, [r4, #0xa8]         @ CRR on entry to this chainloader
        mov     r0, #1
        

        @ copy zImage to 0x84000000
        ldr     r0, =ZIMAGE_SRC
        ldr     r1, =KERNEL_DEST
        ldr     r2, =ZIMAGE_SIZE
        bl      copy_words

        mov     r0, #2
        str     r0, [r4, #4]
        bl      bc_mirrors
        mov     r0, #2
        

        @ copy DTB after the zImage
        ldr     r0, =DTB_SRC
        ldr     r1, =DTB_DEST
        ldr     r2, =DTB_SIZE
        bl      copy_words

        @ DTB magic check
        ldr     r1, =DTB_DEST
        ldr     r0, [r1]
        ldr     r2, =0xEDFE0DD0          @ DTB magic, little-endian word
        cmp     r0, r2
        bne     kernel_fail

        mov     r0, #3
        str     r0, [r4, #4]
        bl      bc_mirrors
        mov     r0, #3
        

        @ Epoch-test block: publish the configuration, then (delay builds
        @ only) hold kernel entry for EP_TICKS WDT2 ticks.  Lives at
        @ breadcrumb +0x88: +0x00..+0x7C belong to the kernel event log,
        @ +0x80/+0x84 to the ring header and +0x100.. to the characters.
        ldr     r4, =BC_PRIMARY
        ldr     r0, =0x48435045          @ "EPCH"
        str     r0, [r4, #0x88]
        ldr     r0, =EP_TICKS
        str     r0, [r4, #0xa0]
        mov     r0, #0
        str     r0, [r4, #0x8c]
        str     r0, [r4, #0x90]
        str     r0, [r4, #0x94]
        str     r0, [r4, #0x98]
        str     r0, [r4, #0x9c]
        str     r0, [r4, #0xa4]
        @ +0xa8 is written much earlier (CRR at chainloader entry): do not
        @ clear it here or the hand-over split is lost.
        mov     r0, #0x100               @ bit8: delay-capable chainloader
        str     r0, [r4, #0x8c]
        bl      ep_publish

        @ Always take one WDT2 sample here (CRR + LDR) so that even a D=0
        @ build measures the pre-kernel duration on the always-on clock,
        @ and so the read is proven safe before a delay build relies on it.
        ldr     r5, =WDT2_CRR
        ldr     r6, [r5]                 @ CRR (counts up from LDR)
        str     r6, [r4, #0x90]
        ldr     r7, [r5, #4]             @ LDR at 0x4A31402c
        str     r7, [r4, #0xa4]
        mov     r0, #0x108               @ bit3: WDT2 sampled
        str     r0, [r4, #0x8c]
        bl      ep_publish

        @ Absolute epoch: the 32k sync counter is NOT re-armed by the boot,
        @ so it is the only timebase comparable across boots.  Sampled last,
        @ because a gated read here would take the run with it - by now the
        @ block above is already in DRAM.
        ldr     r5, =SYNC32K
        ldr     r6, [r5]
        str     r6, [r4, #0xb0]
        ldr     r0, [r4, #0x8c]
        orr     r0, r0, #0x10            @ bit4: 32k sampled
        str     r0, [r4, #0x8c]
        bl      ep_publish
        .if EP_TICKS > 0
        bl      epoch_delay
        .endif

        @ ARM Linux boot protocol, jump to the zImage
        .if BL_PROBE
        bl      bl_probe
        .endif
        mov     r0, #0
        mvn     r1, #0
        ldr     r2, =DTB_DEST
        ldr     pc, =KERNEL_DEST

kernel_fail:
        mov     r0, #0xE1
        str     r0, [r4, #4]
        bl      bc_mirrors
        bl      led_off
kernel_park:
        b       kernel_park

@ ---------------------------------------------------------------------------
@ r0 = src, r1 = dst, r2 = bytes (rounded up to words)
@
@ The MMU and caches are off here, so every access is a single non-cached
@ memory cycle and the loop overhead is a large part of the cost.  Measured on
@ the unit (session 62): a word-at-a-time copy of the 7.5 MB zImage took
@ 0.795-0.832 s of the loader's 7.812 s watchdog window, and the window is what
@ limits an SMP boot (the kernel needs ~0.74 s of its own to reach the late
@ initcall that reprograms WDT2 -- see report 255).  LDM/STM in eight-word
@ bursts keeps the same semantics with far fewer cycles.  r4-r10 are saved
@ because the caller keeps BC_PRIMARY in r4 and the CRR sample in r11.
copy_words:
        push    {r4-r10}
        add     r2, r2, #3
        lsr     r2, r2, #2               @ words
        cmp     r2, #8
        blo     2f
1:      ldmia   r0!, {r3, r4, r5, r6, r7, r8, r9, r10}
        stmia   r1!, {r3, r4, r5, r6, r7, r8, r9, r10}
        subs    r2, r2, #8
        cmp     r2, #8
        bhs     1b
2:      cmp     r2, #0
        beq     3f
        ldr     r3, [r0], #4
        str     r3, [r1], #4
        subs    r2, r2, #1
        bne     2b
3:      pop     {r4-r10}
        bx      lr

bc_mirrors:
        ldr     r1, =BC_MIR1
        ldr     r2, =BC_MIR2
        ldr     r3, =BC_MIR3
        mov     r5, #0
1:      ldr     r0, [r4, r5, lsl #2]
        str     r0, [r1, r5, lsl #2]
        str     r0, [r2, r5, lsl #2]
        str     r0, [r3, r5, lsl #2]
        add     r5, r5, #1
        cmp     r5, #0x40
        blt     1b
        bx      lr

@ ---------------------------------------------------------------------------
@ Epoch-test block layout, relative to each breadcrumb page (BC_PRIMARY and
@ the three mirrors):
@   +0x88  magic "EPCH" (0x48435045)
@   +0x8c  status: bit0 = WDT2 counter observed ticking
@                   bit1 = anomaly (no timebase, or overshoot)
@                   bit2 = delay loop completed
@                   bit3 = WDT2 sampled before kernel entry
@                   bit8 = this chainloader can delay
@   +0x90  CRR at loop entry (loop start); pre-jump sample when no delay
@   +0x94  CRR last read (updated every iteration)
@   +0x98  elapsed ticks = last - start  (32.768 kHz)
@   +0x9c  loop iterations
@   +0xa0  target ticks (EP_TICKS)
@   +0xa4  LDR as read just before kernel entry (arming value)
@ The values are published every iteration, so if the CPU dies mid-delay
@ the block records exactly when, in always-on timer ticks.
ep_publish:                              @ r4 = BC_PRIMARY
        push    {r0-r3}
        ldr     r1, =BC_MIR1
        ldr     r2, =BC_MIR2
        ldr     r3, =BC_MIR3
        mov     r12, #0x88
1:      ldr     r0, [r4, r12]
        str     r0, [r1, r12]
        str     r0, [r2, r12]
        str     r0, [r3, r12]
        add     r12, r12, #4
        cmp     r12, #0xb4
        blt     1b
        pop     {r0-r3}
        bx      lr

@ ---------------------------------------------------------------------------
@ Hold kernel entry for EP_TICKS ticks of the always-on WDT2 counter.
@ WDT2 counts down at 32.768 kHz and is armed by the RIM bootloader, so it is
@ the only timebase guaranteed to be live before any kernel exists.  A gated
@ or stopped module reads back a constant; that is detected (two reads must
@ differ) and the delay falls back to a fixed iteration count.
epoch_delay:
        push    {r4-r11, lr}
        ldr     r4, =BC_PRIMARY
        ldr     r5, =WDT2_CRR
        ldr     r8, =EP_TICKS

        ldr     r6, [r5]                 @ loop-start CRR
        str     r6, [r4, #0x90]
        str     r6, [r4, #0x94]

        mov     r7, #0x2000              @ short settle loop
1:      subs    r7, r7, #1
        bne     1b
        ldr     r0, [r5]
        cmp     r0, r6
        beq     2f                       @ constant -> no usable timebase
        ldr     r0, [r4, #0x8c]          @ keep bit3/bit8 (RMW, never store)
        orr     r0, r0, #0x1             @ ticking
        str     r0, [r4, #0x8c]
        ldr     r7, =0xffffffff          @ cap: none, ticks govern
        b       3f
2:      ldr     r0, [r4, #0x8c]
        orr     r0, r0, #0x2             @ no timebase (anomaly)
        str     r0, [r4, #0x8c]
        ldr     r7, =0x600000            @ fallback: fixed busy loop
3:
        mov     r9, #0                   @ iterations
4:      add     r9, r9, #1
        ldr     r10, [r5]                @ CRR now
        str     r10, [r4, #0x94]
        sub     r11, r10, r6             @ elapsed ticks (CRR counts UP from LDR)
        str     r11, [r4, #0x98]
        str     r9, [r4, #0x9c]
        bl      ep_publish
        cmp     r11, r8
        bhs     5f                       @ target reached
        cmp     r9, r7
        blo     4b                       @ neither target nor cap yet
        ldr     r0, [r4, #0x8c]
        orr     r0, r0, #0x2             @ cap hit
        str     r0, [r4, #0x8c]
        b       6f
5:      ldr     r0, [r4, #0x8c]
        orr     r0, r0, #0x4             @ completed on the timebase
        cmp     r11, r8, lsl #2          @ more than 4x the target?
        orrhi   r0, r0, #0x2             @ counter reloaded under us
        str     r0, [r4, #0x8c]
6:      bl      ep_publish
        pop     {r4-r11, lr}
        bx      lr

led_off:
        ldr     r0, =GPIO1
        ldr     r1, =EN_BIT
        str     r1, [r0, #GPIO_CLEAR]
        bx      lr

@ ---------------------------------------------------------------------------
@ Stage-1 probe.  BL_PROBE selects the mode (default 0 = off):
@   1 = DUMP the executing bootloader's key regions to the DTS no-map
@       pbmon-low page (0xA0200000).  Pure reads: no calls, no writes.
@   2 = CALL the bootloader's BOOTCTR_FCTRY selector, after re-enabling the
@       CM2 L4SEC crypto clocks the tail disabled.  Read-only at the RPMB
@       level.  Stash {l4sec ret, selector ret, value, WDT2 before/after}.
@ The bootloader's arm9000 section (media file 0x9000) is loaded at
@ 0x80000000 and is resident here; it verified region 0 and decremented the
@ counter just before jumping to us.  MMU/caches are off, so these are
@ physical addresses.
@ IMPORTANT (session 26 correction): reports 150/151 quoted these code
@ addresses as if media file 0 == 0x80000000.  The arm9000 section at media
@ file 0x9000 is what is loaded at 0x80000000, so every CODE address in those
@ reports is 0x9000 too high.  The addresses below are the corrected ones
@ (verified against the executing image with BL_PROBE=1).  Data literals such
@ as 0x80025F00 / 0x80025FB0 / 0x8001431C are stored absolute values and are
@ correct as-is.
@ Linux readback:  peek a0200000 16   (mode 1)  /  peek a0200000 8  (mode 2)
@ mode 1 stash: +0x00 "BLDU" +0x04 WDT2 CRR; then copied regions:
@   +0x010 0x80000000 0x160 | +0x180 0x800085E0 0xC0 | +0x240 0x8000C8E0 0xC0
@   +0x300 0x80014318 0x050 | +0x350 0x8000F100 0xF0 | +0x440 0x80010220 0x90
@   +0x4D0 0x8000F3D8 0x050 | +0x520 0x80000078 0x28
@ mode 2 stash: +0x00 "PROB" +0x04 l4sec ret +0x08 selector ret +0x0c value
@   +0x10 WDT2 CRR before +0x14 WDT2 CRR after (+0x100 = out slot)
        .if BL_PROBE == 1
        .equ BL_STASH, 0xA0200000
bl_probe:
        push    {r4, r5, r6, lr}
        ldr     r4, =BL_STASH
        ldr     r0, =0x424C4455          @ "BLDU": executing-bootloader dump
        str     r0, [r4, #0]
        ldr     r5, =WDT2_CRR
        ldr     r6, [r5]
        str     r6, [r4, #4]
        ldr     r0, =0x80000000
        add     r1, r4, #0x10
        mov     r2, #0x160
        bl      copy_words
        ldr     r0, =0x800085E0
        add     r1, r4, #0x180
        mov     r2, #0xC0
        bl      copy_words
        ldr     r0, =0x8000C8E0
        add     r1, r4, #0x240
        mov     r2, #0xC0
        bl      copy_words
        ldr     r0, =0x80014318
        add     r1, r4, #0x300
        mov     r2, #0x50
        bl      copy_words
        ldr     r0, =0x8000F100
        add     r1, r4, #0x350
        mov     r2, #0xF0
        bl      copy_words
        ldr     r0, =0x80010220
        add     r1, r4, #0x440
        mov     r2, #0x90
        bl      copy_words
        ldr     r0, =0x8000F3D8
        add     r1, r4, #0x4D0
        mov     r2, #0x50
        bl      copy_words
        ldr     r0, =0x80000078
        add     r1, r4, #0x520
        mov     r2, #0x28
        bl      copy_words
        pop     {r4, r5, r6, pc}
        .endif

        .if BL_PROBE == 2
        .equ BL_STASH, 0xA0200000
        .equ BL_L4SEC, 0x8000F108        @ ARM: CM2 L4SEC crypto clock enable
        .equ BL_SEL_T, 0x800000CF        @ Thumb: selector(u32 *out)
bl_probe:
        push    {r4, r5, r6, lr}
        ldr     r4, =BL_STASH
        ldr     r0, =0x50524F42          @ "PROB": call probe ran
        str     r0, [r4, #0]
        ldr     r5, =WDT2_CRR
        ldr     r6, [r5]
        str     r6, [r4, #0x10]
        ldr     r12, =BL_L4SEC
        blx     r12                      @ re-enable the crypto clocks
        str     r0, [r4, #4]
        mvn     r0, #0
        str     r0, [r4, #0x0c]          @ out preload
        add     r0, r4, #0x100
        ldr     r12, =BL_SEL_T
        blx     r12                      @ selector(&out)
        str     r0, [r4, #8]
        ldr     r1, [r4, #0x100]
        str     r1, [r4, #0x0c]
        ldr     r6, [r5]
        str     r6, [r4, #0x14]
        pop     {r4, r5, r6, pc}
        .endif

@ mode 3: the tail wipes the bootloader's RPMB store state and catalogue
@ ([0x80025E78,0x800517C4)), so re-run the bootloader's own mount
@ (0x800082DC, which opens the MMC, validates block 0, and rebuilds the
@ catalogue) after re-enabling L4SEC, then read the counter back.
@ stash: +0x00 "MOUN" +0x04 l4sec ret +0x08 mount ret +0x0c selector ret
@        +0x10 value +0x14 WDT2 before +0x18 WDT2 after
        .if BL_PROBE == 3
        .equ BL_STASH, 0xA0200000
        .equ BL_L4SEC, 0x8000F108        @ ARM: CM2 L4SEC crypto clock enable
        .equ BL_MOUNT_T, 0x800082DD      @ Thumb: mount / catalogue rebuild
        .equ BL_SEL_T, 0x800000CF        @ Thumb: selector(u32 *out)
bl_probe:
        push    {r4, r5, r6, lr}
        ldr     r4, =BL_STASH
        ldr     r0, =0x4E554F4D          @ "MOUN"
        str     r0, [r4, #0]
        ldr     r5, =WDT2_CRR
        ldr     r6, [r5]
        str     r6, [r4, #0x14]
        ldr     r12, =BL_L4SEC
        blx     r12                      @ re-enable the crypto clocks
        str     r0, [r4, #4]
        ldr     r12, =BL_MOUNT_T
        blx     r12                      @ rebuild the record catalogue
        str     r0, [r4, #8]
        mvn     r0, #0
        str     r0, [r4, #0x10]          @ out preload
        add     r0, r4, #0x100
        ldr     r12, =BL_SEL_T
        blx     r12                      @ selector(&out)
        str     r0, [r4, #0x0c]
        ldr     r1, [r4, #0x100]
        str     r1, [r4, #0x10]
        ldr     r6, [r5]
        str     r6, [r4, #0x18]
        pop     {r4, r5, r6, pc}
        .endif

@ The LED blink stages (blink_n/delay/led_on) are gone: 12 uncached
@ 0x04000000-iteration loops cost 1.8-4.8 s and varied with the bootloader's
@ MPU clock, which also moved where in kernel time a capture died.  The stage
@ breadcrumbs (+0x04) and the epoch block carry the same information.
