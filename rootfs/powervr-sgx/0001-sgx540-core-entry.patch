+
+/*
+ * 256 MiB, the GPL sgxconfig.h 28-bit layout (no general mapping heap, no large
+ * general heap: the build's defaults). Every base is that header's; a heap runs
+ * to the next one's base.
+ *
+ * That header has no texture heap on a 28-bit core - textures come out of the
+ * general heap - so, as sgx530_heaps does, the top half of the general region
+ * ([0x00001000, 0x08800000) in the header) is given to the texture heap: the
+ * client heaps must not overlap, and the split point is ours, not the DDK's.
+ *
+ * kernel code and PDS vertex lie within 64 MiB above PDS_EXEC_BASE (0x0dc00000):
+ * 0x0e400000 and 0x0e800000 are, so pds_reach() passes without
+ * EDM_VERTEX_PDSADDR_FULL_RANGE.
+ */
+static const struct pvrsgx_heap_layout sgx540_heaps = {
+	.general = { 0x00001000, 0x04400000 },
+	.texture = { 0x04400000, 0x08800000 },
+	.params_3d = { 0x08800000, 0x0c800000 },
+	.ta_data = { 0x0c800000, 0x0d800000 },
+	.sync = { 0x0d800000, 0x0dc00000 },
+	.pds_pixel = { 0x0dc00000, 0x0e400000 },
+	.kernel_code = { 0x0e400000, 0x0e800000 },
+	.pds_vertex = { 0x0e800000, 0x0f000000 },
+	.kernel_data = { 0x0f000000, 0x0f400000 },
+	.usse_pixel = { 0x0f400000, 0x0f900000 },
+	.usse_vertex = { 0x0fc00000, 0x0fe00000 },
+	/* Half the 64 MiB PB heap, as the SGX530's: the free list and VM objects hold the rest. */
+	.pb_max_pages = 0x2000,
+};
