+/*
+ * SGX540 (TI OMAP4430/4460/4470), from the GPL sgx540defs.h of DDK 1.17.4948957
+ * and its devices/sgx/sgxconfig.h 28-bit heap block.
+ *
+ * It is the SGX545's register layout for the clock gates, reset, events and the
+ * MMU's page-size machinery, but CORE_ID/CORE_REVISION sit 4 bytes higher, the
+ * kicks sit lower, the address space is 28 bits, one memory context, and the
+ * USE_CODE_BASE fields are one bit narrower (24-bit address, DM at bit 24).
+ * There are no BIF bank registers and no per-requestor request bases.
+ */
+static const struct pvrsgx_core_regs sgx540_regs = {
+	.core_id = 0x0020,
+	.core_revision = 0x0024,
+	/*
+	 * Every 2-bit gating field, ISP b0-1 through TA b18-19: unlike the
+	 * SGX545 (whose units stop at PDS b14-15), the SGX540 also gates IDXFIFO
+	 * (b16-17) and TA (b18-19). AUTO_MAN_REG (b24) and SYSTEM_CLKG (b28) are
+	 * single bits, not 2-bit fields, so they stay out of the SGX_CLKG_ALL
+	 * mask; the system clock is handled where it is enabled.
+	 */
+	.clkgatectl_units = GENMASK(19, 0),
+	.clkgatectl_dpm = GENMASK(11, 10),
+	.clkgatectl2 = 0x0004,
+	/* PBE b0-1, CACHEL2 b2-3, UCACHEL2 b4-5, USE0 b6-7, ITR0 b8-9,
+	 * TEX0 b10-11, MADD0 b12-13, USE1 b14-15, ITR1 b16-17, TEX1 b18-19,
+	 * MADD1 b20-21.
+	 */
+	.clkgatectl2_units = GENMASK(21, 0),
+	.clkgatestatus = 0x0008,
+	/* One status bit per unit; DPM is b5. */
+	.clkgatestatus_dpm = BIT(5),
+	.soft_reset_bif = BIT(0),
+	/* VDM b1, DPM b2, TE b3, MTE b4, ISP b5, ISP2 b6, TSP b7, PDS b8,
+	 * PBE b9, CACHEL2 b10, UCACHEL2 b11, MADD b12, ITR b13, TEX b14,
+	 * USE b15, IDXFIFO b16, TA b17.
+	 */
+	.soft_reset_cores = GENMASK(17, 1),
+	.event_kick2 = 0x0ac0,
+	.event_kick2_now = BIT(0),
+	.use_code_base0 = 0x0a0c,
+	.pds_exec_base = 0x0ab8,
+	/*
+	 * BIF_INT_STAT differs from the SGX545's: fault requests are b0-13 and
+	 * b14 is PF_N_RW (read or write). There is no separate fault-type field,
+	 * so bif_int_stat_fault_type is that read/write bit.
+	 */
+	.bif_int_stat_fault_req = GENMASK(13, 0),
+	.bif_int_stat_fault_type = BIT(14),
+	/* BIF_FAULT address b12-27. */
+	.bif_fault_addr = GENMASK(27, 12),
+	/* No BIF bank registers on a single-context core. */
+	.bif_bank_set = 0,
+	.bif_bank0 = 0,
+	/* 24-bit address field, data master at bit 24 (SGX535/545 use bit 25). */
+	.use_code_base_dm_shift = 24,
+	/*
+	 * 256-byte units, as the SGX530's: the same 24-bit field layout and the
+	 * same 28-bit address space, and a byte unit could not reach the code
+	 * heaps at 0x0e400000 through 24 bits. The granule is a guess until a
+	 * USSE task runs (fact sheet Gap 7); the SGX545 fetches at 128 bytes.
+	 */
+	.use_code_base_addr_shift = 8,
+	.cr_b30 = 0x0b30,
+	/* The event PDS registers are not in the 1.17 GPL header the rest of this
+	 * table comes from; the offsets are the SGX545's and are checked by reading
+	 * back before the first kick.  The enable value is not a guess any more: the
+	 * GPL-2 DDK 1.8's own srvinit derives 0x2204f00f for this core (see
+	 * SGX540_CR_EVENT_PDS_ENABLE_ALL in pvrsgx_hw.h), which differs from the
+	 * SGX545's by SW_EVENT -- the source the microkernel raises to signal the host.
+	 */
+	.event_pds_enable = SGX545_CR_EVENT_PDS_ENABLE,
+	.event_pds_enable_all = SGX540_CR_EVENT_PDS_ENABLE_ALL,
+	.event_pds_base = SGX545_CR_EVENT_PDS_BASE,
+	.event_pds_data0 = SGX545_CR_EVENT_PDS_DATA0,
+	.event_pds_data1 = SGX545_CR_EVENT_PDS_DATA1,
+};
+
+/* Init script part 2 for the SGX540: the host's interrupt, as the SGX530's. */
+static const struct pvrsgx_core_init_reg sgx540_init_regs[] = {
