@@ -22,6 +22,17 @@
  */
 #define SGX545_CR_EVENT_PDS_ENABLE		0x0a58	/* host events start the event program */
 #define   SGX545_CR_EVENT_PDS_ENABLE_ALL	0x2204b00f
+/*
+ * The SGX540's value, from the GPL-2 DDK 1.8 (eurasia/services4/srvinit/
+ * devices/sgx/sgxinit.c, the non-SGX_FEATURE_MP branch, with
+ * EUR_CR_EVENT_PDS_ENABLE_SW_EVENT_MASK defined in sgx540defs.h): BREAKPOINT |
+ * DPM_OUT_OF_MEMORY_ZLS | SW_EVENT | TIMER, then TA_FINISHED | TA_TERMINATE |
+ * DPM_REACHED_MEM_THRESH | DPM_OUT_OF_MEMORY_GBL | DPM_OUT_OF_MEMORY_MT |
+ * DPM_3D_MEM_FREE | PIXELBE_END_RENDER.  It differs from the SGX545's by
+ * exactly one bit -- SW_EVENT (0x4000) -- which is the source the microkernel
+ * raises to signal the host.
+ */
+#define   SGX540_CR_EVENT_PDS_ENABLE_ALL	0x2204f00f
 #define SGX545_CR_EVENT_PDS_BASE		0x0a68	/* the event PDS program, 16-byte aligned */
 #define SGX545_CR_EVENT_PDS_DATA0		0x0a6c
 #define SGX545_CR_EVENT_PDS_DATA1		0x0a70
