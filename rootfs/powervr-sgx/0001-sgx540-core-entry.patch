@@ -134,6 +134,41 @@ static void core_test_cpu_latency(struct kunit *test)
 	}
 }
 
+/*
+ * The SGX540: one directory list, 28 bits, multi-event kick, 4 USE pipes; its
+ * CORE_ID/REVISION and kick offsets are the sgx540defs.h ones, not the SGX545's.
+ */
+static void core_test_sgx540(struct kunit *test)
+{
+	const struct pvrsgx_core_family *f = pvrsgx_core_family_get(540);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_EXPECT_TRUE(test, pvrsgx_core_family_usable(f));
+	KUNIT_EXPECT_TRUE(test, pvrsgx_core_single_context(f));
+	KUNIT_EXPECT_EQ(test, f->num_dir_lists, 1);
+	KUNIT_EXPECT_EQ(test, f->va_bits, 28);
+	KUNIT_EXPECT_EQ(test, f->core_id, 0x01140000);
+	/* No BRN_28889 in the SGX540's rev-120 errata (26620/28011/34028). */
+	KUNIT_EXPECT_EQ(test, f->quirks, 0);
+	/* Multi-event kick, so the second kick register must be named. */
+	KUNIT_EXPECT_TRUE(test, !!(f->features & PVRSGX_FEATURE_MULTI_EVENT_KICK));
+	KUNIT_EXPECT_EQ(test, f->regs->event_kick2, 0x0ac0);
+	/* No BIF bank registers on a single-context core. */
+	KUNIT_EXPECT_EQ(test, f->regs->bif_bank_set, 0);
+	KUNIT_EXPECT_EQ(test, f->regs->bif_bank0, 0);
+	/* The SGX540's USE_CODE_BASE is 24-bit / DM at bit 24, not the 545's 25/25. */
+	KUNIT_EXPECT_EQ(test, f->regs->use_code_base_dm_shift, 24);
+	KUNIT_EXPECT_EQ(test, pvrsgx_core_family_get(545)->regs->use_code_base_dm_shift, 25);
+	/* CORE_ID/REVISION moved 4 bytes up from the SGX545's. */
+	KUNIT_EXPECT_EQ(test, f->regs->core_id, 0x0020);
+	KUNIT_EXPECT_EQ(test, f->regs->core_revision, 0x0024);
+	KUNIT_EXPECT_STREQ(test, pvrsgx_core_lookup(f, 0x01140000, 0x00010200)->name,
+			   "TI OMAP4430 (SGX540 1.2.0)");
+	/* The SGX545's id/revision are not this core's. */
+	KUNIT_EXPECT_NULL(test, pvrsgx_core_lookup(f, 0x01150000, 0x00010200));
+	KUNIT_EXPECT_NULL(test, pvrsgx_core_lookup(f, 0x01140000, 0x0001000e));
+}
+
