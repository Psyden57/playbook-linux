# 0007 - the SGX's interrupt reaches the CPU, and the PDS launch program fixed
#
# Session 76.  Five defects, each measured on the reference unit.
#
# 1. The interrupt was never wired to the CPU.  On OMAP4 the SGX core's request
#    enters the ti,sysc target module's IRQSTATUS_2 (window offset 0xfe38) and
#    reaches the GIC only while IRQENABLE_SET_2 (0xfe44) bit 0 is set.  The
#    vendor's OMAP4 platform code enables exactly that pair and maps the whole
#    64 KiB window (SYS_OMAP4430_SGX_REGS_SIZE 0xFFFF); on Linux it also defines
#    SGX_OCP_NO_INT_BYPASS, so THALIA_INT_BYPASS is NOT used there.  This driver
#    mapped only 0x4000 and never touched the wrapper, so EVENT_STATUS bit 31
#    could stay set with irq 147 at count 0.  With the gate opened, irq 147 ran
#    0 -> 100000.  Userspace cannot do it: a /dev/mem write there is an external
#    abort (L4 firewall).
#
# 2. FIX_HW_BRN_30852 ("turns off PDS auto clock gating").  In the SGX540's
#    rev-120 errata block.  srvinit writes CLKGATECTL_PDS_CLKG_ON where every
#    other unit gets _AUTO.  This driver set every unit to AUTO: CLKGATECTL read
#    0x000aa6aa and CLKGATESTATUS bit 7 (PDS) read set -- the PDS was parked.
#    Now a per-core quirk; CLKGATECTL reads 0x000a66aa.
#
# 3. EUR_CR_PDS (0x0abc) was never written, leaving DOUT_TIMEOUT_DISABLE (b6)
#    clear, i.e. the PDS data-store timeout armed.  srvinit writes it; so did our
#    own SGX545 init list (0x0e).  The SGX540 value is 0x40 (chunk start 0 on a
#    UNIFIED_TEMPS_AND_PAS core, timeout disabled).
#
# 4. The single-context edm_init launch program did not fit PVRSGX_FW_PDS0's
#    0x18-byte slot: data = 12 put its code at word 12 (needing words 0..13),
#    while PDS1 at +0x20 is built after it and occupies words 8..21, so it
#    overwrote this program's DS1[0] and its DOUTU/HALT.  Init still ran only
#    because PDS1's DOUTU encodes the same code base and offset.  Now data = 4:
#    words 0-2 data, 4 MOVS, 5 HALT, inside the slot.
#
# 5. EVENT_PDS_DATA (0x0a6c) is the data segment's size in 16-byte units
#    (EUR_CR_EVENT_OTHER_PDS_DATA_SIZE_ALIGNSHIFT = 4).  It said 3 (= 48 bytes)
#    for that 24-byte slot.  Now 1 (= 16 bytes), consistent with (4).
#
# The microkernel side is in the same commit: ukernel.py's init_set no longer ORs
# EVENT_TIMER into EVENT_HOST_ENABLE.  That bit says "interrupt the host", and
# srvinit writes SW_EVENT only; the dispatch mask is EVENT_PDS_ENABLE, which
# already carries TIMER.  With the OR in place every 1 kHz tick raised a host
# interrupt the ISR had to reject and the line was disabled at 100000.
#
# Two read-only debugfs nodes are added for the next session: "pds" prints the
# event-PDS register beside the buffer it resolves to (the comparison trap 393
# says the old check_event_pds() could not make), and "timer_edge" clears the
# latched TIMER bit and re-reads the microkernel's tick counter.
#
# Still open: the EDM dispatches once and never again.  Every host-side input is
# now measured correct and the tick counter still reads 1, so the fault is in the
# microkernel task's admission, not in this configuration.
#
# Applies after 0001-0006 to a pristine 95f78ca.  Verified: 0001..0007 reproduce
# the built tree byte-for-byte (pvrsgx_device.c, pvrsgx_pds.c, ukernel.py
# compared).  Module md5 with this patch: 37a329a6b40d8e1f10ee61110a15523c.
diff --git a/drm/powervr_sgx/pvrsgx_hw.h b/drm/powervr_sgx/pvrsgx_hw.h
--- a/drm/powervr_sgx/pvrsgx_hw.h
+++ b/drm/powervr_sgx/pvrsgx_hw.h
@@ -20,6 +20,26 @@
  * what the microkernel and the init script do with them. Code reaches them
  * through the core table.
  */
+/*
+ * The OCP wrapper around the SGX core (the ti,sysc target module). The SGX's
+ * own interrupt line is not wired to the GIC: the core's request enters the
+ * wrapper at IRQSTATUS_2 and reaches the CPU only once IRQENABLE_SET_2 has
+ * bit 0 set. The vendor's OMAP4 kernel driver maps the whole 64 KiB SGX window
+ * and enables exactly this pair (sgxinit-adjacent, eurasia_km/services4/system/
+ * omap4/sysconfig.c SysEnableSGXInterrupts(); on Linux it also defines
+ * SGX_OCP_NO_INT_BYPASS, so the THALIA_INT_BYPASS bit in OCP_DEBUG_CONFIG is
+ * NOT used there). These offsets are the GPL out-of-tree OCP header's
+ * (hwdefs/ocpdefs.h).
+ */
+#define PVRSGX_OCP_WINDOW_SIZE			0x10000
+/* IRQSTATUS_2, IRQENABLE_SET_2 and IRQENABLE_CLR_2 all live in this one page. */
+#define PVRSGX_OCP_PAGE_OFF			0xf000
+#define PVRSGX_OCP_PAGE_SIZE			0x1000
+#define PVRSGX_OCP_IRQSTATUS_2			0xfe38
+#define PVRSGX_OCP_IRQENABLE_SET_2		0xfe44
+#define PVRSGX_OCP_IRQENABLE_CLR_2		0xfe50
+#define PVRSGX_OCP_IRQ_SGXCORE			BIT(0)
+
 #define SGX545_CR_EVENT_PDS_ENABLE		0x0a58	/* host events start the event program */
 #define   SGX545_CR_EVENT_PDS_ENABLE_ALL	0x2204b00f
 /*
diff --git a/drm/powervr_sgx/pvrsgx_device.h b/drm/powervr_sgx/pvrsgx_device.h
--- a/drm/powervr_sgx/pvrsgx_device.h
+++ b/drm/powervr_sgx/pvrsgx_device.h
@@ -139,6 +139,12 @@
 
 	/** @regs: The core registers (BAR 0). */
 	void __iomem *regs;
+	/**
+	 * @ocp: The OCP wrapper's interrupt registers when the core's request
+	 * reaches the CPU through them (OMAP4's ti,sysc target module), else NULL.
+	 * They sit past the core window the driver maps for @regs.
+	 */
+	void __iomem *ocp;
 	/** @vdc: The display engine's registers when it carries the SGX's interrupt, or NULL. */
 	void __iomem *vdc;
 	/** @irq: Its interrupt. */
@@ -400,6 +406,37 @@
 }
 
 /*
+ * The OCP wrapper's gate on the SGX core's interrupt. On OMAP4 the core's
+ * request is not wired straight to the GIC: it enters the wrapper's
+ * IRQSTATUS_2 and the wrapper forwards it only while IRQENABLE_SET_2 bit 0 is
+ * set. The vendor's driver enables that pair on every clock-enable. Without
+ * it the core may raise EVENT_STATUS's MASTER_INTERRUPT forever with the CPU
+ * line never asserting -- exactly the state measured here.
+ *
+ * Only the wrapper's own page is mapped (@ocp points at window offset
+ * PVRSGX_OCP_PAGE_OFF), so the window offsets are rebased onto it. Reading
+ * past the mapped page -- or using the window's absolute offsets -- is an
+ * external abort, which is how the first attempt at this crashed.
+ */
+#define PVRSGX_OCP_REG(off)	((off) - PVRSGX_OCP_PAGE_OFF)
+
+static inline void pvrsgx_ocp_irq(struct pvrsgx_device *sdev, bool on)
+{
+	if (!sdev->ocp)
+		return;
+	if (on) {
+		/* The pending bit first, then the enable: the vendor's order. */
+		iowrite32(PVRSGX_OCP_IRQ_SGXCORE,
+			  sdev->ocp + PVRSGX_OCP_REG(PVRSGX_OCP_IRQSTATUS_2));
+		iowrite32(PVRSGX_OCP_IRQ_SGXCORE,
+			  sdev->ocp + PVRSGX_OCP_REG(PVRSGX_OCP_IRQENABLE_SET_2));
+	} else {
+		iowrite32(PVRSGX_OCP_IRQ_SGXCORE,
+			  sdev->ocp + PVRSGX_OCP_REG(PVRSGX_OCP_IRQENABLE_CLR_2));
+	}
+}
+
+/*
  * The microkernel translates through the last directory list; TA, 3D and
  * host requests through list 0, which the microkernel points at the job's
  * page directory.
diff --git a/drm/powervr_sgx/pvrsgx_device.c b/drm/powervr_sgx/pvrsgx_device.c
--- a/drm/powervr_sgx/pvrsgx_device.c
+++ b/drm/powervr_sgx/pvrsgx_device.c
@@ -425,6 +425,8 @@
 	/* Only with the handler in place. */
 	if (!err && sdev->vdc)
 		vdc_irq_enable(sdev, true);
+	if (!err)
+		pvrsgx_ocp_irq(sdev, true);
 	return err;
 }
 
@@ -439,6 +441,7 @@
 #endif
 	if (sdev->vdc)
 		vdc_irq_enable(sdev, false);
+	pvrsgx_ocp_irq(sdev, false);
 	free_irq(sdev->irq, sdev);
 }
 
