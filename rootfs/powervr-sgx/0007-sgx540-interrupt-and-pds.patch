+/*
+ * The PDS programs the EDM starts USSE tasks from, as they sit in the code
+ * arena, plus the address the event-PDS register actually resolves to.  This is
+ * the one view that can tell "the event program is at the right place" from
+ * "EVENT_PDS_EXEC points somewhere else": the register is compared with the
+ * buffer, not with our own derivation again (trap 393).
+ *
+ * Read-only: it reads the driver's own firmware buffers and the one register
+ * the driver already writes.
+ */
+static int pds_show(struct seq_file *m, void *unused)
+{
+	struct drm_debugfs_entry *entry = m->private;
+	struct pvrsgx_device *sdev = to_pvrsgx_device(entry->dev);
+	const struct pvrsgx_heap_layout *h = pvrsgx_heaps(sdev);
+	struct pvrsgx_fw *f = &sdev->fw;
+	u32 exec = sgx_rd(sdev, sdev->cr->event_pds_base);
+	u32 want = f->addr[PVRSGX_FW_PDS0] & ~0xfu;
+	u32 resolved;
+
+	seq_printf(m, "event_pds_base reg 0x%04x = 0x%08x\n", sdev->cr->event_pds_base, exec);
+	seq_printf(m, "  as an offset from pds_pixel.base 0x%08x -> 0x%08x\n",
+		   (u32)h->pds_pixel.base, (u32)h->pds_pixel.base + exec);
+	seq_printf(m, "  PDS0 buffer dev addr (aligned)   = 0x%08x\n", want);
+	seq_printf(m, "  offsets match: %s\n",
+		   (want - (u32)h->pds_pixel.base) == exec ? "yes" : "NO");
+	resolved = (u32)h->pds_pixel.base + exec;
+	seq_printf(m, "  resolved target 0x%08x is %s the PDS0 stub\n", resolved,
+		   resolved == want ? "exactly" :
+		   (resolved > want && resolved < want + 0x200) ? "inside" : "OUTSIDE");
+	/* The stub's own words, and the first words of the image's event entry. */
+	seq_printf(m, "PDS0 stub (%u words):\n", 0x18 / 4);
+	for (int i = 0; i < 0x18 / 4; i++)
+		seq_printf(m, "  [%2d] 0x%08x\n", i, ((u32 *)f->cpu[PVRSGX_FW_PDS0])[i]);
+	seq_printf(m, "image entry 0 (event) first 8 words, at 0x%08x:\n",
+		   f->addr[PVRSGX_FW_UKERNEL]);
+	for (int i = 0; i < 8; i++)
+		seq_printf(m, "  [%2d] 0x%08x\n", i, ((u32 *)f->cpu[PVRSGX_FW_UKERNEL])[i]);
+	return 0;
+}
+
+/*
+ * Is the EDM edge-triggered on a latched event bit?  EVENT_STATUS's TIMER bit
+ * (b29) is set at every reading and never cleared: the event is raised, the
+ * dispatch mask has it (EVENT_PDS_ENABLE b29), the exec address resolves to
+ * PDS0 -- and the event program is not entered (the tick counter stands still).
+ * One explanation is that a permanently-latched bit never produces a new edge,
+ * so the PDS never fires again.  This node tests exactly that: it reads the
+ * microkernel's tick counter, clears EVENT_STATUS's TIMER bit through
+ * EVENT_HOST_CLEAR, waits, and reads the counter again.  If the counter moves,
+ * the dispatch was waiting for the ack.
+ *
+ * Clearing a status bit this way is what the microkernel's own dispatcher does
+ * (and/str to HOST_CLEAR) and what the driver's reset path does for the whole
+ * word, so it is a supported operation, not an invented one.
+ */
+static int timer_edge_show(struct seq_file *m, void *unused)
+{
+	struct drm_debugfs_entry *entry = m->private;
+	struct pvrsgx_device *sdev = to_pvrsgx_device(entry->dev);
+	u32 *ctl = sdev->fw.cpu[PVRSGX_FW_TA3DCTL];
+	u32 before, mid, after, status;
+
+	before = READ_ONCE(ctl[0x2c]);
+	status = sgx_rd(sdev, SGX_CR_EVENT_STATUS);
+	seq_printf(m, "EVENT_STATUS  0x%08x (TIMER b29 = %u)\n", status,
+		   !!(status & SGX_CR_EVENT_STATUS_TIMER));
+	seq_printf(m, "tick counter before      0x%08x\n", before);
+
+	/* Clear just the TIMER bit, as the dispatcher would. */
+	sgx_wr(sdev, SGX_CR_EVENT_HOST_CLEAR, SGX_CR_EVENT_STATUS_TIMER);
+	mid = sgx_rd(sdev, SGX_CR_EVENT_STATUS);
+	seq_printf(m, "EVENT_STATUS after clear 0x%08x (TIMER b29 = %u)\n", mid,
+		   !!(mid & SGX_CR_EVENT_STATUS_TIMER));
+
+	msleep(30);
+	after = READ_ONCE(ctl[0x2c]);
+	seq_printf(m, "tick counter after       0x%08x   %s\n", after,
+		   after != before ? "*** ADVANCED: the EDM was waiting on the ack ***"
+				   : "(unchanged)");
+	seq_printf(m, "EVENT_STATUS re-read     0x%08x\n",
+		   sgx_rd(sdev, SGX_CR_EVENT_STATUS));
+
+	/*
+	 * Read the register the EDM fetches PDS code through, and the PDS's own
+	 * status pair. If the send/execute never completes, one of these says so
+	 * rather than the tick counter merely standing still.
+	 */
+	seq_printf(m, "\nEUR_CR_PDS          0x%08x  (DOUT_TIMEOUT_DISABLE b6 = %u)\n",
+		   sgx_rd(sdev, 0xabc), !!(sgx_rd(sdev, 0xabc) & 0x40));
+	seq_printf(m, "PDS_CACHE_STATUS    0x%08x\n", sgx_rd(sdev, 0x138));
+	seq_printf(m, "PDS_CACHE_ENABLE    0x%08x\n", sgx_rd(sdev, 0xa54));
+	seq_printf(m, "PDS_CACHE_HOST_EN   0x%08x\n", sgx_rd(sdev, 0x13c));
+	seq_printf(m, "EVENT_TIMER         0x%08x\n", sgx_rd(sdev, SGX_CR_EVENT_TIMER));
+	return 0;
+}
+
 static const struct drm_debugfs_info pvrsgx_debugfs_list[] = {
 	{ "status", status_show, 0 },
 	{ "ctlblk", ctlblk_show, 0 },
 	{ "render", render_show, 0 },
 	{ "disp_enable", dispen_show, 0 },
+	{ "pds", pds_show, 0 },
+	{ "timer_edge", timer_edge_show, 0 },
 };
 
