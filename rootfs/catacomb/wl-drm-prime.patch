diff -ruN a/src/protocols/wl_drm.rs b/src/protocols/wl_drm.rs
--- a/src/protocols/wl_drm.rs	1969-12-31 21:00:00.000000000 -0300
+++ b/src/protocols/wl_drm.rs	2026-11-23 19:17:46.000000000 -0300
@@ -0,0 +1,187 @@
+//! Legacy `wl_drm` protocol, PRIME-only.
+//!
+//! Mesa's Wayland EGL platform obtains the DRM fd **only** through `wl_drm`
+//! (report 269): without it `eglInitialize()` silently falls back to
+//! `swrast_dri`.  catacomb is a Smithay compositor and serves no `wl_drm`, so
+//! every unmodified Mesa client (Qt, GTK, WPE WebKit, …) was software-rendered.
+//!
+//! This module exposes a minimal `wl_drm` global backed by the compositor's
+//! existing dmabuf import path ([`smithay::backend::renderer::buffer_type`]):
+//! it advertises the render node and the PRIME capability, and turns
+//! `create_prime_buffer` into a `wl_buffer` carrying a
+//! [`Dmabuf`][smithay::backend::allocator::dmabuf::Dmabuf] as user data, which
+//! [`smithay::backend::renderer::ImportBuffer`] recognises exactly like a
+//! `zwp_linux_dmabuf_v1` buffer.  The legacy GEM-name requests are rejected;
+//! Mesa uses PRIME when the capability is advertised.
+
+use std::os::fd::OwnedFd;
+
+use smithay::backend::allocator::dmabuf::{Dmabuf, DmabufFlags};
+use smithay::backend::allocator::{Fourcc, Modifier};
+use smithay::backend::drm::{DrmNode, NodeType};
+use smithay::reexports::wayland_server::{
+    Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource,
+};
+
+use crate::catacomb::Catacomb;
+
+pub mod protocol {
+    //! Server bindings generated from `protocols/wayland-drm.xml`.
+    pub use wayland_server;
+
+    use wayland_server::protocol::*;
+
+    pub mod __interfaces {
+        use wayland_server::protocol::__interfaces::*;
+
+        wayland_scanner::generate_interfaces!("protocols/wayland-drm.xml");
+    }
+
+    use self::__interfaces::*;
+
+    wayland_scanner::generate_server_code!("protocols/wayland-drm.xml");
+}
+
+use protocol::wl_drm::{self, WlDrm};
+
+/// Version of the `wl_drm` global we advertise (version 2 adds PRIME).
+const WL_DRM_VERSION: u32 = 2;
+
+/// `wl_drm` error code: invalid format.
+const ERROR_INVALID_FORMAT: u32 = 1;
+/// `wl_drm` error code: invalid name (used for the unsupported GEM path).
+const ERROR_INVALID_NAME: u32 = 2;
+
+/// Register the `wl_drm` global on the compositor display.
+pub fn init(display: &DisplayHandle) {
+    display.create_global::<Catacomb, WlDrm, ()>(WL_DRM_VERSION, ());
+}
+
+impl GlobalDispatch<WlDrm, ()> for Catacomb {
+    fn bind(
+        state: &mut Self,
+        _handle: &DisplayHandle,
+        _client: &Client,
+        resource: New<WlDrm>,
+        _global_data: &(),
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        let resource = data_init.init(resource, ());
+
+        // Point the client at the render node: Mesa skips authentication for a
+        // render node and loads the driver from the fd.
+        let path = state.dmabuf_node.as_ref().and_then(|node: &DrmNode| {
+            node.dev_path_with_type(NodeType::Render).or_else(|| node.dev_path())
+        });
+        if let Some(path) = path {
+            let _ = resource.send_event(wl_drm::Event::Device {
+                name: path.to_string_lossy().into_owned(),
+            });
+        }
+
+        // Formats the renderer can import.
+        for format in [Fourcc::Argb8888, Fourcc::Xrgb8888] {
+            let _ = resource.send_event(wl_drm::Event::Format { format: format as u32 });
+        }
+
+        // PRIME capability (wl_drm version 2).
+        if resource.version() >= 2 {
+            let _ = resource.send_event(wl_drm::Event::Capabilities {
+                value: wl_drm::Capability::Prime as u32,
+            });
+        }
+    }
+}
+
+impl Dispatch<WlDrm, ()> for Catacomb {
+    fn request(
+        state: &mut Self,
+        _client: &Client,
+        resource: &WlDrm,
+        request: wl_drm::Request,
+        _data: &(),
+        _display: &DisplayHandle,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        match request {
+            wl_drm::Request::Authenticate { .. } => {
+                // A render-node device needs no authentication.
+                let _ = resource.send_event(wl_drm::Event::Authenticated);
+            }
+            wl_drm::Request::CreatePrimeBuffer {
+                id,
+                name,
+                width,
+                height,
+                format,
+                offset0,
+                stride0,
+                offset1,
+                stride1,
+                offset2,
+                stride2,
+            } => {
+                let planes = [(offset0, stride0), (offset1, stride1), (offset2, stride2)];
+                match build_dmabuf(state, name, width, height, format, planes) {
+                    Some(buffer) => {
+                        data_init.init(id, buffer);
+                    }
+                    None => data_init.post_error(id, ERROR_INVALID_FORMAT, "unsupported dmabuf"),
+                }
+            }
+            // We advertise PRIME only; Mesa does not use the legacy GEM path.
+            wl_drm::Request::CreateBuffer { id, .. }
+            | wl_drm::Request::CreatePlanarBuffer { id, .. } => {
+                data_init.post_error(id, ERROR_INVALID_NAME, "GEM names unsupported; use PRIME")
+            }
+        }
+    }
+}
+
+/// Build a [`Dmabuf`] from a `wl_drm` PRIME request.
+fn build_dmabuf(
+    state: &Catacomb,
+    fd: OwnedFd,
+    width: i32,
+    height: i32,
+    format: u32,
+    planes: [(i32, i32); 3],
+) -> Option<Dmabuf> {
+    if width <= 0 || height <= 0 {
+        return None;
+    }
+
+    let format = Fourcc::try_from(format).ok()?;
+    let mut builder =
+        Dmabuf::builder((width, height), format, Modifier::Invalid, DmabufFlags::empty());
+
+    if let Some(node) = state.dmabuf_node {
+        builder.set_node(node);
+    }
+
+    // `wl_drm` passes one fd for all planes of a planar buffer.
+    let mut fd = Some(fd);
+    let mut added = false;
+    for (idx, (offset, stride)) in planes.into_iter().enumerate() {
+        if stride <= 0 {
+            continue;
+        }
+
+        let plane_fd = if added {
+            fd.as_ref()?.try_clone().ok()?
+        } else {
+            fd.take()?
+        };
+
+        if !builder.add_plane(plane_fd, idx as u32, offset.max(0) as u32, stride as u32) {
+            return None;
+        }
+        added = true;
+    }
+
+    if !added {
+        return None;
+    }
+
+    builder.build()
+}
