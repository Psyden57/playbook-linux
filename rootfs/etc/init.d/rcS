#!/bin/sh
# rcS -- first userspace script in the PlayBook region-1 root.
#
# The initramfs already created the USB gadget and mounted devtmpfs/proc/sys
# for its own use.  We are now in a chroot over the eMMC root, so mount the
# filesystems again where they belong in *this* root; a duplicate mount of
# devtmpfs/proc/sys is harmless if it is already there.

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mkdir -p /proc /sys /dev /tmp /run /root /var/log
mount -t proc    proc    /proc 2>/dev/null
mount -t sysfs   sysfs   /sys  2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts  devpts  /dev/pts 2>/dev/null
mount -t tmpfs   tmpfs   /tmp  2>/dev/null
mount -t tmpfs   tmpfs   /run  2>/dev/null

hostname playbook 2>/dev/null

# Make the module tree usable: depmod writes modules.dep from the .ko files
# installed under /lib/modules/$(uname -r).  Harmless when there are none.
if [ -d "/lib/modules/$(uname -r)" ]; then
	depmod -a 2>/dev/null
fi

# The I2C4 sensor cluster (session 28).  Each is a no-op when the module or
# the device is absent; the i2c clients themselves come from the DTS.
for m in evdev bma150 hmc5843_i2c mpu3050 hwmon tmp103 bq27xxx_battery_i2c \
	 leds-fan5702 cm3217 twl6030-gpadc twl6030_charger; do
	modprobe "$m" 2>/dev/null
done

# Audio (session 38): the WM8994 on ABE/McBSP2.  These are loaded here, after
# the initramfs has already created the USB gadget, so the codec/card probe
# cannot delay the gadget's enumeration (that delay is the USB regression the
# built-in probes caused).  Order matters only in that the codec and McBSP
# should exist before the generic card binds; modprobe resolves the rest.
for m in wm8994 snd-soc-wm-hubs snd-soc-wm8994 snd-soc-ti-sdma \
	 snd-soc-omap-mcbsp snd-soc-playbook-wm8994; do
	modprobe "$m" 2>/dev/null
done

# OSS emulation for a simple playback probe (/dev/dsp -> the ALSA PCM).
for m in snd-mixer-oss snd-pcm-oss; do
	modprobe "$m" 2>/dev/null
done

# WM8994 playback path (the codec resets its DAPM switches on probe): AIF1.1
# into both DAC1 mixers, DAC1 unmuted, DAC1 into the output mixers and the
# speaker mixers, and the speaker output stages on.  The headphone mux stays
# on "Mixer" (the output-mixer path).
pbmix on "DAC1L Mixer AIF1.1"           2>/dev/null
pbmix on "DAC1R Mixer AIF1.1"           2>/dev/null
pbmix set "DAC1 Switch" 1               2>/dev/null
pbmix on "Left Output Mixer DAC Switch"  2>/dev/null
pbmix on "Right Output Mixer DAC Switch" 2>/dev/null
pbmix on "SPKL DAC1 Switch"             2>/dev/null
pbmix on "SPKR DAC1 Switch"             2>/dev/null
pbmix on "SPKL Output Switch"           2>/dev/null
pbmix on "SPKR Output Switch"           2>/dev/null

# One line in the kernel log, so the boot is visible from kmsg even when the
# console is not attached.
{
	printf '<6>PBROOT: region-1 root booted: '
	uname -a
} > /dev/kmsg 2>/dev/null

exit 0
